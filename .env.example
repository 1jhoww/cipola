# Optional overrides. Defaults for domain, e-mail, CNPJ, address and WhatsApp live in src/lib/site.ts.
# Canonical origin, default https://www.cipolamarmoraria.com.br.
NEXT_PUBLIC_SITE_URL=
# 1 keeps the whole site out of search engines. Vercel previews are always noindex.
NEXT_PUBLIC_NOINDEX=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SERVICE_AREA=
# Search Console (HTML tag method) and Bing Webmaster Tools tokens: only the content value.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Absolute HTTPS endpoint that accepts JSON. Server-side only.
QUOTE_WEBHOOK_URL=
QUOTE_WEBHOOK_TOKEN=
# Higgsfield (development only, used by scripts/generate-material-images.mjs).
# Format <api key id>:<api key secret>. Never use a NEXT_PUBLIC prefix.
HF_CREDENTIALS=
# Data controller shown in the privacy policy (LGPD).
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_CNPJ=
# Channel for data subject requests. Falls back to NEXT_PUBLIC_CONTACT_EMAIL.
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_DPO_NAME=
# Ads and analytics. Each tag loads only after the visitor accepts cookies.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
